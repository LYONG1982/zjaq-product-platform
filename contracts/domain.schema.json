{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain.schema.json",
  "title": "RC2 lightweight domain contracts",
  "$defs": {
    "TextItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text"
      ]
    },
    "MediaRef": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "role": {
          "enum": [
            "cover",
            "screenshot",
            "diagram"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false,
      "required": [
        "mediaId",
        "assetId",
        "role",
        "alt"
      ]
    },
    "PreviewRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pdf"
            },
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "pageCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "assetId",
            "pageCount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "images"
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "pageIndex": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "additionalProperties": false,
                "required": [
                  "assetId",
                  "pageIndex",
                  "alt"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "pages"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "video"
            },
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "mimeType": {
              "enum": [
                "video/mp4",
                "video/quicktime",
                "video/webm"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "assetId",
            "mimeType"
          ]
        }
      ]
    },
    "MaterialRef": {
      "type": "object",
      "properties": {
        "materialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "brochure",
            "presentation",
            "technical",
            "other"
          ]
        },
        "category": {
          "enum": [
            "promotional",
            "technical"
          ]
        },
        "subCategory": {
          "enum": [
            "deck",
            "onepager",
            "video",
            "whitepaper",
            "spec",
            "manual"
          ]
        },
        "versionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "applicableVersion": {
          "type": "string",
          "maxLength": 100
        },
        "sourceAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "$ref": "#/$defs/PreviewRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "materialId",
        "versionId",
        "name",
        "kind",
        "versionLabel",
        "preview"
      ]
    },
    "DraftContent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "templateId": {
          "enum": [
            "software",
            "device",
            "delivery",
            "ai"
          ]
        },
        "templateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "maxLength": 80
        },
        "aliases": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "tagline": {
          "type": "string",
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "maxLength": 1500
        },
        "audiences": {
          "type": "string",
          "maxLength": 1000
        },
        "problemValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "technical": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "boundaries": {
          "type": "string",
          "maxLength": 3000
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaRef"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialRef"
          },
          "maxItems": 20
        },
        "model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "productType": {
          "enum": [
            "SOFTWARE",
            "HARDWARE"
          ]
        },
        "ownership": {
          "enum": [
            "SELF_DEVELOPED",
            "PARTNER"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "categoryId",
        "templateId",
        "templateVersion",
        "owner",
        "tagline",
        "summary",
        "problemValues",
        "features",
        "scenarios",
        "technical",
        "boundaries",
        "media",
        "materials"
      ]
    },
    "CreateProduct": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "templateId": {
          "enum": [
            "software",
            "device",
            "delivery",
            "ai"
          ]
        },
        "templateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "aliases": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "productType": {
          "enum": [
            "SOFTWARE",
            "HARDWARE"
          ]
        },
        "ownership": {
          "enum": [
            "SELF_DEVELOPED",
            "PARTNER"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "categoryId",
        "templateId",
        "templateVersion",
        "owner",
        "model",
        "productType",
        "ownership"
      ]
    },
    "SaveDraft": {
      "type": "object",
      "properties": {
        "expectedDraftVersion": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "$ref": "#/$defs/DraftContent"
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedDraftVersion",
        "content"
      ]
    },
    "PublishProduct": {
      "type": "object",
      "properties": {
        "expectedDraftVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expectedPublicationVersion": {
          "type": "integer",
          "minimum": 0
        },
        "publicContentConfirmed": {
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedDraftVersion",
        "expectedPublicationVersion",
        "publicContentConfirmed"
      ]
    },
    "UnpublishProduct": {
      "type": "object",
      "properties": {
        "expectedPublicationVersion": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "maxLength": 300,
          "default": "内容调整"
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedPublicationVersion"
      ]
    },
    "ProductRecord": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^(?:ZJ-[0-9]{3,}|ZJ-[DYSA]-[SH]-[AB]-[0-9]{3})$"
        },
        "publicId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "isDemo": {
          "type": "boolean"
        },
        "pilotOrder": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "publicationState": {
          "enum": [
            "DRAFT",
            "PUBLISHED",
            "OFFLINE"
          ]
        },
        "activeReleaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastReleaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "publicationVersion": {
          "type": "integer",
          "minimum": 0
        },
        "releaseSequence": {
          "type": "integer",
          "minimum": 0
        },
        "draftVersion": {
          "type": "integer",
          "minimum": 1
        },
        "lastPublishedDraftVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "publicMaterialRevocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "draft": {
          "$ref": "#/$defs/DraftContent"
        },
        "internal": {
          "type": "object"
        },
        "deletedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "deletedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "deletionReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      },
      "additionalProperties": false,
      "required": [
        "productId",
        "isDemo",
        "publicationState",
        "activeReleaseId",
        "publicationVersion",
        "releaseSequence",
        "draftVersion",
        "draft"
      ]
    },
    "UploadIntent": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "purpose": {
          "enum": [
            "preview",
            "source",
            "media"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentType": {
          "type": "string",
          "maxLength": 120
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288000
        }
      },
      "additionalProperties": false,
      "required": [
        "productId",
        "purpose",
        "fileName",
        "contentType",
        "size"
      ]
    },
    "UploadComplete": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "uploadId"
      ]
    },
    "CategoryWrite": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "defaultTemplateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "allowedTemplateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "shortName",
        "sortOrder",
        "enabled",
        "defaultTemplateId",
        "allowedTemplateIds"
      ]
    },
    "AdminUserWrite": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "enum": [
            "CONTENT_MANAGER",
            "ADMIN",
            "SALES"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "subjectId",
        "displayName",
        "role",
        "enabled"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "fieldErrors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "message"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "error",
        "requestId"
      ]
    },
    "SiteBannerWrite": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/SiteBannerItemWrite" }
        },
        "imageData": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600000
        },
        "link": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "startsAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "endsAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "introduction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "introLink": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    "SiteBannerItemWrite": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "imageData": { "type": ["string", "null"], "maxLength": 600000 },
        "link": { "type": ["string", "null"], "maxLength": 2048 },
        "startsAt": { "type": ["string", "null"], "maxLength": 40 },
        "endsAt": { "type": ["string", "null"], "maxLength": 40 }
      },
      "required": ["id", "imageData", "link", "startsAt", "endsAt"],
      "additionalProperties": false
    },
    "SiteContactWrite": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "officialQr": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 350000
        },
        "serviceQr": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 350000
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      },
      "required": [
        "expectedVersion",
        "officialQr",
        "serviceQr",
        "phone"
      ],
      "additionalProperties": false
    },
    "FeedbackSubmit": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "contact": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "content",
        "contact"
      ],
      "additionalProperties": false
    },
    "AnalyticsSettingsWrite": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "downloadEnabled": {
          "type": "boolean"
        },
        "viewEnabled": {
          "type": "boolean"
        },
        "dashboardEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "expectedVersion",
        "downloadEnabled",
        "viewEnabled",
        "dashboardEnabled"
      ],
      "additionalProperties": false
    },
    "AnalyticsViewSubmit": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "maxLength": 64
        },
        "materialId": {
          "type": "string",
          "maxLength": 64
        },
        "releaseId": {
          "type": "string",
          "maxLength": 64
        },
        "versionId": {
          "type": "string",
          "maxLength": 64
        },
        "viewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "client": {
          "enum": [
            "H5",
            "WECHAT"
          ]
        }
      },
      "required": [
        "productId",
        "materialId",
        "releaseId",
        "versionId",
        "viewId",
        "client"
      ],
      "additionalProperties": false
    },
    "ProductRemoval": {
      "type": "object",
      "properties": {
        "expectedDraftVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expectedPublicationVersion": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "confirmed": {
          "const": true
        }
      },
      "required": [
        "expectedDraftVersion",
        "expectedPublicationVersion",
        "reason",
        "confirmed"
      ],
      "additionalProperties": false
    }
  }
}
