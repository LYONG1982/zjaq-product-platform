# 本文件与根 .env 不会被应用自动加载；启动命令需显式注入所需变量。
APP_ENV=development
DATA_PROVIDER=mysql
API_PORT=3100
API_BIND_HOST=127.0.0.1

# MySQL 5.7+，数据库与账号需预先创建；密码只通过运行环境注入，不提交实际值。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zj_app
MYSQL_PASSWORD=
MYSQL_DATABASE=zjaq
# 私有上传文件目录，默认 work/storage。
ZJ_STORAGE_DIR=work/storage

# 仅 pnpm db:init 读取，用于创建首个管理员；不要写入前端产物。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 精确的浏览器 origin 与 API Host，逗号分隔；不做通配。
ALLOWED_ORIGINS=http://127.0.0.1:3200,http://127.0.0.1:3201,http://127.0.0.1:3202
ALLOWED_HOSTS=127.0.0.1:3100,localhost:3100

PORTAL_API_BASE_URL=http://127.0.0.1:3100/api/v1
VITE_API_BASE_URL=http://127.0.0.1:3100/api/v1
WECHAT_APP_ID=
BUSINESS_TIMEZONE=Asia/Shanghai

# PC 销售会话：生产环境必须是唯一的 64 位十六进制密钥（32 随机字节）；
# 开发环境未配置时使用进程内临时密钥。
PORTAL_SESSION_SECRET=
# 反向代理后的精确对外 HTTPS origin，结尾不带斜杠。
PORTAL_PUBLIC_ORIGIN=

# 精确可信的反向代理 IP，逗号分隔。为空时忽略转发头。
# 不要加入客户端可控地址或通配符；启用前先核实实际网关链路。
TRUSTED_PROXY_ADDRESSES=

# 后台只读媒体 Cookie，Base64 编码的独立 32 字节随机密钥。多实例共享；不提交实际值。
# ADMIN_MEDIA_SESSION_SECRET=
# FFprobe 为受信任的系统二进制，可配置绝对路径；不配置时从受控 PATH 查找 ffprobe。
# FFPROBE_PATH=/usr/bin/ffprobe
# Windows Server 示例：C:\Tools\ffmpeg\bin\ffprobe.exe（仅当 API 部署于 Windows）
# 值为单个绝对路径，不包含额外引号或参数；由实际服务启动器注入。
# 运行 pnpm check:video-runtime 验证实际环境。
