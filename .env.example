APP_ENV=development
DATA_PROVIDER=mock
API_PORT=3100
PORTAL_API_BASE_URL=http://127.0.0.1:3100/api/v1
VITE_API_BASE_URL=http://127.0.0.1:3100/api/v1
# Mock only; this marker is not a real credential. The local API is loopback-only.
VITE_MOCK_TOKEN=local-mock
# Real mode is configured separately and has not been cloud-validated.
CLOUDBASE_ENV_ID=
ADMIN_IDENTITY_PROVIDER=cloudbase
ADMIN_BOOTSTRAP_SUBJECT_ID=
WECHAT_APP_ID=
BUSINESS_TIMEZONE=Asia/Shanghai
# Real service configuration: blanks deliberately fail closed; no cloud connection by default.
CLOUDBASE_COLLECTION_PREFIX=zj_
CLOUDBASE_AUTH_ORIGIN=
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
API_BIND_HOST=127.0.0.1
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_AUTH_ORIGIN=
# Only the isolated local test server enables local-admin. Never set in real mode.
ENABLE_MOCK_ROLES=false

# PC sales: production requires a unique 64-hex-character secret (32 random bytes).
# An ephemeral key is generated only in development; real login never falls back to Mock.
PORTAL_SESSION_SECRET=
# Exact public HTTPS origin when behind a reverse proxy, without trailing slash.
PORTAL_PUBLIC_ORIGIN=
NEXT_PUBLIC_CLOUDBASE_ENV_ID=
NEXT_PUBLIC_CLOUDBASE_AUTH_ORIGIN=
NEXT_PUBLIC_ENABLE_SALES_MOCK=false

# Exact trusted reverse-proxy IPs, comma-separated. Empty ignores forwarding headers.
# Do not add client-controlled addresses or wildcards; validate the actual gateway chain before enabling.
TRUSTED_PROXY_ADDRESSES=

# 后台只读媒体 Cookie，Base64 编码的独立 32 字节随机密钥。多实例共享；不提交实际值。
# ADMIN_MEDIA_SESSION_SECRET=
# FFprobe 为受信任的系统二进制，可配置绝对路径；不配置时从受控 PATH 查找 ffprobe。
# FFPROBE_PATH=/usr/bin/ffprobe
