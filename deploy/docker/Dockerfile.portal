# PC 销售门户镜像：Next.js 16（未启用 standalone，运行期需要完整 node_modules）
# 构建上下文必须是仓库根目录：
#   docker build -f deploy/docker/Dockerfile.portal -t zjaq/portal:<tag> .
FROM node:22-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/usr/local/pnpm \
    PATH=/usr/local/pnpm:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@11.13.1 \
 && npm cache clean --force

WORKDIR /app

COPY . .

# 服务端渲染时通过容器内网访问 API；浏览器侧一律走门户自身的 /api 路由
ARG PORTAL_API_BASE_URL=http://api:3100/api/v1
ENV PORTAL_API_BASE_URL=$PORTAL_API_BASE_URL \
    NODE_ENV=production

# build:portal 会先复制 PDF.js 预览资源到 public/pdf，再执行 next build
RUN pnpm install --frozen-lockfile \
 && pnpm build:portal \
 && chown -R node:node /app

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/usr/local/pnpm \
    PATH=/usr/local/pnpm:$PATH \
    PORT=3000

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@11.13.1 \
 && npm cache clean --force

WORKDIR /app

COPY --from=build --chown=node:node /app /app

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["pnpm", "--filter", "@zj/portal", "exec", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
