# nginx 模板：由官方镜像入口脚本用 envsubst 渲染为 /etc/nginx/conf.d/default.conf
# 仅替换 ${PORTAL_DOMAIN} 等已注入的环境变量，$host/$uri 等 nginx 变量保持不变。
# 证书固定挂载到 /etc/nginx/certs/{fullchain.pem,privkey.pem}。
#
# 域名口径（2026-11-11，备案前由 OpenResty 8443 转入）：
#   portal  PC 门户，浏览器走 Next 自身的 /api，不在此处反代
#   admin   管理后台，浏览器走同源 /api/v1
#   wx      H5 宣传页 + 小程序接口：静态页同源托管，/api 反代到 api 容器

server {
    listen 80;
    server_name ${PORTAL_DOMAIN} ${ADMIN_DOMAIN} ${WX_DOMAIN};
    return 301 https://$host$request_uri;
}

# PC 销售门户（Next.js）
server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 32m;

    # /api/* 归 Next.js 路由处理器所有，禁止在此反代
    location / {
        proxy_pass http://portal:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# 管理后台（静态 SPA）
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root  /usr/share/nginx/html/admin;
    index index.html;
    add_header X-Content-Type-Options nosniff always;

    # 后台单文件上传上限 500 MiB，代理层留余量并关闭请求缓冲
    client_max_body_size 512m;
    client_body_timeout 120s;

    # 浏览器同源 /api：转发到 API 容器
    location /api/v1/ {
        proxy_pass http://api:3100;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# H5 宣传页（同源托管）+ 小程序接口（/api 反代）
server {
    listen 443 ssl;
    http2 on;
    server_name ${WX_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 32m;

    root  /usr/share/nginx/html/h5;
    index index.html;

    # 小程序与 H5 共用同一份接口前缀
    location /api/ {
        proxy_pass http://api:3100;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
