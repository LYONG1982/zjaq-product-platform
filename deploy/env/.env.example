# 生产环境变量模板
# 使用：cd deploy && cp env/.env.example .env，然后填写全部空值。
# 该文件同时用于 docker compose 插值和镜像构建脚本；不要提交真实 .env。

# ---------- 域名 ----------
# 三域口径：portal（PC 门户）、admin（管理后台）、wx（H5 + 小程序接口）。
# H5 挂在 wx 域名下，与小程序共用 /api/v1；不再有 h5 与 api 子域。
PORTAL_DOMAIN=portal.product.zhongjianquan.com
ADMIN_DOMAIN=admin.product.zhongjianquan.com
WX_DOMAIN=wx.product.zhongjianquan.com

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=zjaq
MYSQL_USER=zj_app
MYSQL_PASSWORD=

# ---------- API ----------
# 精确 origin，逗号分隔，不做通配。浏览器 Origin 含端口，8443 过渡期必须带 :8443。
# admin 同源 /api/v1；H5（wx）同源 /api/v1；portal 走 Next 自身 /api，不需要列。
ALLOWED_ORIGINS=https://admin.product.zhongjianquan.com,https://admin.product.zhongjianquan.com:8443,https://wx.product.zhongjianquan.com:8443
# admin/wx 经 web 透传 Host（nginx $host 不含端口，无需写 :8443）；api:3100 供 portal 服务端调用；127.0.0.1:3100 供容器健康检查
ALLOWED_HOSTS=admin.product.zhongjianquan.com,wx.product.zhongjianquan.com,api:3100,127.0.0.1:3100
# 随机 32 字节，Base64；生成：openssl rand -base64 32
ADMIN_MEDIA_SESSION_SECRET=
# 受信任的反向代理地址（compose 中 web 服务固定 IP）
# 1Panel OpenResty 前置反代时，还需追加 OpenResty -> web 的实测来源地址（通常为 172.28.0.1），逗号分隔
TRUSTED_PROXY_ADDRESSES=172.28.0.10
BUSINESS_TIMEZONE=Asia/Shanghai

# ---------- PC 门户 ----------
# 对外 HTTPS origin，结尾不带斜杠。备案前经 8443 访问，必须带 :8443；
# 备案完成切回 443 后改回不带端口的值并重启 portal。
PORTAL_PUBLIC_ORIGIN=https://portal.product.zhongjianquan.com:8443
# 随机 32 字节十六进制；生成：openssl rand -hex 32
PORTAL_SESSION_SECRET=

# ---------- 证书与镜像 ----------
# 证书目录（只读挂载到 /etc/nginx/certs），需包含 fullchain.pem 与 privkey.pem
# 证书 SAN 只需覆盖 portal、admin、wx 三个域名
TLS_DIR=./certs
# 镜像标签，构建、导出、启动必须一致
IMAGE_TAG=2026-11-11
